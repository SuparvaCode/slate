# API server configuration. Copy to services/server/.env and fill in your own values.
# Never commit the filled-in file. Real environment variables override this file.

# --- Firebase -----------------------------------------------------------------------------------
# Base64-encoded service-account JSON. Alternatively leave unset and use
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json, or `gcloud auth application-default login`.
FIREBASE_SERVICE_ACCOUNT=
# Expected token audience. Set it explicitly to your project id.
FIREBASE_PROJECT_ID=
# Adds <project>.firebaseapp.com to the CSP frame/connect sources.
FIREBASE_AUTH_DOMAIN=

# --- AI provider --------------------------------------------------------------------------------
# groq (default) or anthropic
SLATE_PROVIDER=groq
# One or more Groq keys, comma-separated; they are rotated.
GROQ_API_KEYS=
# Used when SLATE_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
SLATE_ANTHROPIC_BASE_URL=
# A single Groq key. GROQ_API_KEYS (above) is preferred; this is kept for simple setups.
GROQ_API_KEY=

# --- Optional OpenAI-compatible gateway ---------------------------------------------------------
# With one of these keys set, a second provider is used when the primary is rate-limited, and for
# the notes planner. Any OpenAI-compatible /chat/completions endpoint works: point
# EXPLABS_BASE_URL at your own. Leave both keys unset to use Groq/Anthropic only.
EXPLABS_API_KEY=
EXPERIENTIAL_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# Model that takes over when the primary is rate-limited; leave a value empty to turn that hand-over off.
SLATE_RECOGNIZE_BACKUP=claude-haiku-5.5
SLATE_SOLVE_BACKUP=claude-haiku-5.5
# Comma-separated models for notes planning, tried in order.
SLATE_NOTES_THINKERS=deepseek-v4.1-flash,claude-haiku-5.5
# Model that picks the right answer when checking a practice question.
SLATE_JEV_MODEL=jev-latest
# 0 = never hand a request to the gateway, even when a key is set.
SLATE_FALLBACKS=1

# Per-tool model overrides (leave empty for provider defaults)
SLATE_RECOGNIZE_MODEL=
SLATE_SOLVE_MODEL=
SLATE_DIAGRAM_MODEL=
SLATE_NOTES_MODEL=
SLATE_ASSIST_MODEL=
SLATE_RECOGNIZE_EFFORT=
SLATE_NOTES_REASONING=

# --- Notes verification -------------------------------------------------------------------------
# 1 = drop worked examples the calculator cannot confirm (see notes-guard.ts). 0 = keep them.
SLATE_NOTES_GUARD=1

# --- Development switches (never enable in production) ------------------------------------------
# 1 = canned AI output, no provider calls.
SLATE_MOCK=0
# 1 = accept API calls without a Firebase token. Ignored when NODE_ENV=production.
SLATE_AUTH_DISABLED=0

# --- HTTP ----------------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8787
# Reverse-proxy hops for per-IP limits. Defaults to 1 in production, 0 otherwise. Never set to true.
SLATE_TRUST_PROXY=
# Comma-separated CORS allow-list. Needed only when web and API are on different origins.
SLATE_ALLOWED_ORIGINS=
# Extra connect-src hosts for the Content-Security-Policy.
SLATE_CSP_CONNECT=

# --- Static web app ------------------------------------------------------------------------------
# 1 = serve apps/web/dist from the API (production default recommended).
SLATE_SERVE_WEB=0
SLATE_WEB_DIST=../../apps/web/dist

# --- Quotas (abuse protection; not a commercial feature) ----------------------------------------
SLATE_LIMIT_SOLVE_DAY=200
SLATE_LIMIT_DIAGRAM_DAY=60
SLATE_LIMIT_MOLECULE_DAY=300
SLATE_LIMIT_ASSIST_DAY=80
SLATE_LIMIT_NOTES_DAY=120
SLATE_LIMIT_SEARCH_DAY=400
SLATE_AI_TOKENS_DAY=1400000
# Per-account burst limits (requests per minute), so one tab cannot drain a day's allowance at once.
SLATE_BURST_SOLVE_MIN=10
SLATE_BURST_DIAGRAM_MIN=6
SLATE_BURST_MOLECULE_MIN=30
SLATE_BURST_ASSIST_MIN=10
SLATE_BURST_NOTES_MIN=20
SLATE_BURST_SEARCH_MIN=40
# Requests per minute per IP, checked before sign-in.
SLATE_IP_PER_MIN=120
# Concurrent solve streams per account.
SLATE_MAX_STREAMS=2
# firestore (persistent) or memory (development; resets on restart).
SLATE_QUOTA_STORE=

# --- Recognition records (off by default) -------------------------------------------------------
# 1 = keep every recognition crop and its result under SLATE_SAMPLES_DIR, so accuracy can be
# measured (GET /api/accuracy, POST /api/feedback). This writes pictures of students' handwriting to
# the operator's disk: turn it on deliberately, keep the directory private, and say so in your
# privacy policy. It is not sent anywhere and is not used to train a model.
SLATE_SAVE_SAMPLES=0
SLATE_SAMPLES_DIR=data/samples

# --- Optional integrations -----------------------------------------------------------------------
# Web and image search; the search routes return 503 without these.
SLATE_SEARCH_KEY=
SLATE_SEARCH_WEB_URL=
SLATE_SEARCH_IMAGE_URL=
# TURN credentials for voice in collaboration rooms.
TURN_URLS=
TURN_SECRET=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Lifetime of a TURN credential, in seconds (clamped to 600–86400).
TURN_TTL_S=14400

# --- Diagnostics --------------------------------------------------------------------------------
# 1 = log each counted AI call and its token count, for sizing SLATE_AI_TOKENS_DAY.
SLATE_LOG_TOKENS=0

# Point at a different env file if you do not use services/server/.env.
SLATE_ENV_FILE=
