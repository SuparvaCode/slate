# API server configuration. Copy to services/server/.env and fill in your own values.
# Never commit the filled-in file. Real environment variables override this file.

# --- Firebase -----------------------------------------------------------------------------------
# Base64-encoded service-account JSON. Alternatively leave unset and use
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json, or `gcloud auth application-default login`.
FIREBASE_SERVICE_ACCOUNT=
# Expected token audience. Set it explicitly to your project id.
FIREBASE_PROJECT_ID=
# Adds <project>.firebaseapp.com to the CSP frame/connect sources.
FIREBASE_AUTH_DOMAIN=

# --- AI provider --------------------------------------------------------------------------------
# groq (default) or anthropic
SLATE_PROVIDER=groq
# One or more Groq keys, comma-separated; they are rotated.
GROQ_API_KEYS=
# Used when SLATE_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
SLATE_ANTHROPIC_BASE_URL=

# Per-tool model overrides (leave empty for provider defaults)
SLATE_RECOGNIZE_MODEL=
SLATE_SOLVE_MODEL=
SLATE_DIAGRAM_MODEL=
SLATE_NOTES_MODEL=
SLATE_ASSIST_MODEL=
SLATE_RECOGNIZE_EFFORT=
SLATE_NOTES_REASONING=

# --- Development switches (never enable in production) ------------------------------------------
# 1 = canned AI output, no provider calls.
SLATE_MOCK=0
# 1 = accept API calls without a Firebase token. Ignored when NODE_ENV=production.
SLATE_AUTH_DISABLED=0

# --- HTTP ----------------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8787
# Reverse-proxy hops for per-IP limits. Defaults to 1 in production, 0 otherwise. Never set to true.
SLATE_TRUST_PROXY=
# Comma-separated CORS allow-list. Needed only when web and API are on different origins.
SLATE_ALLOWED_ORIGINS=
# Extra connect-src hosts for the Content-Security-Policy.
SLATE_CSP_CONNECT=

# --- Static web app ------------------------------------------------------------------------------
# 1 = serve apps/web/dist from the API (production default recommended).
SLATE_SERVE_WEB=0
SLATE_WEB_DIST=../../apps/web/dist

# --- Quotas (abuse protection; not a commercial feature) ----------------------------------------
SLATE_LIMIT_SOLVE_DAY=200
SLATE_LIMIT_DIAGRAM_DAY=60
SLATE_LIMIT_MOLECULE_DAY=300
SLATE_LIMIT_ASSIST_DAY=80
SLATE_LIMIT_NOTES_DAY=120
SLATE_LIMIT_SEARCH_DAY=400
SLATE_AI_TOKENS_DAY=1400000
# firestore (persistent) or memory (development; resets on restart).
SLATE_QUOTA_STORE=

# --- Optional integrations -----------------------------------------------------------------------
# Web and image search; the search routes return 503 without these.
SLATE_SEARCH_KEY=
SLATE_SEARCH_WEB_URL=
SLATE_SEARCH_IMAGE_URL=
# TURN credentials for voice in collaboration rooms.
TURN_URLS=
TURN_SECRET=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Point at a different env file if you do not use services/server/.env.
SLATE_ENV_FILE=
