{
  "name": "slate-server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Slate API: handwriting recognition, calculator-checked solving, diagrams and molecules.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --watch-path=src src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 \"tests/**/*.test.ts\"",
    "test:ci": "node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit \"tests/**/*.test.ts\"",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mathjs": "^15.2.0",
    "nerdamer": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
