# Web app configuration. Copy to apps/web/.env and fill in your own Firebase web app values.
# These values are public by design; access is controlled by Firebase rules and by restricting
# the API key to your domains in the Google Cloud console.

# Required
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Required for collaboration rooms (Realtime Database)
VITE_FIREBASE_DATABASE_URL=

# Optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Leave empty to disable Firebase Analytics entirely. The app loads no analytics code without it.
VITE_FIREBASE_MEASUREMENT_ID=
